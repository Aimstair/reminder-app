<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget, Quick Settings tile and share target (S-61…S-63). Colors follow
     design-direction.md §3 tokens. -->
<resources>
    <string name="widget_title">Reminder App</string>
    <string name="widget_add">New reminder</string>
    <string name="widget_empty">Nothing coming up</string>
    <string name="widget_description">Quick add and your next reminders</string>
    <string name="tile_label">+ Reminder</string>
    <string name="share_label">Reminder App</string>

    <color name="widget_surface">#FFFFFFFF</color>
    <color name="widget_text">#FF000000</color>
    <color name="widget_text_secondary">#993C3C43</color>
    <color name="widget_accent">#FF007AFF</color>

    <!-- Fixed 30dp rows, 6dp apart (14 + 40 + 3 × 36 + 14 = 176dp): three fit evenly in a 2×2 widget. -->
    <style name="WidgetRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="WidgetBar">
        <item name="android:layout_width">4dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:src">@drawable/widget_bar</item>
        <item name="android:scaleType">fitXY</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="WidgetRowText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="WidgetRowTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="WidgetRowWhen">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_text_secondary</item>
        <item name="android:ellipsize">end</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
